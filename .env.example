# Public build-time settings for the web app (Vite reads VITE_* variables).
# Copy to .env.production.local (or set in CI) before `pnpm build`.

# Your Turnstile widget's *site* key (public). Leave unset in development to use
# Cloudflare's always-pass test key. The matching *secret* goes in TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=
