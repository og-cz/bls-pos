{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pos-fast",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves both the API and the React build (Workers Static Assets).
  // /api/* always reaches the Worker; everything else is a static file or the SPA shell.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // D1, R2 and cron bindings are added in later phases (see docs/ROADMAP.md).
}
