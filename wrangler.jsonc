{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilis-pos",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves both the API and the React build (Workers Static Assets).
  // /api/* always reaches the Worker; everything else is a static file or the SPA shell.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bilis-pos",
      // Replace with the ID printed by `wrangler d1 create bilis-pos` before deploying.
      // Local dev and tests ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Set with `wrangler secret put <NAME>` in production, `.dev.vars` locally.
  "secrets": { "required": ["PEPPER", "TURNSTILE_SECRET"] },
  // R2 and cron bindings are added in later phases (see docs/ROADMAP.md).
}
