{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bls-pos",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves both the API and the React build (Workers Static Assets).
  // /api/* always reaches the Worker; everything else is a static file or the SPA shell.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bls-pos",
      // Replace with the ID printed by `wrangler d1 create bls-pos` before deploying.
      // Local dev and tests ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Images (logos, covers, products, avatars). Create with `wrangler r2 bucket create bls-pos-media`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bls-pos-media" }],
  // Set with `wrangler secret put <NAME>` in production, `.dev.vars` locally.
  "secrets": { "required": ["PEPPER", "TURNSTILE_SECRET", "TOTP_ENC_KEY"] },
  // Public shop pages (/api/v1/public/*): at most 120 requests a minute per visitor IP.
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
  ],
  // Nightly daily summaries at 16:10 UTC = 00:10 in Manila (src/worker/cron.ts), and hourly
  // backups at :25, each shop in its own hour (src/worker/backup.ts).
  "triggers": { "crons": ["10 16 * * *", "25 * * * *"] },
}
