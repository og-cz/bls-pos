{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bls-pos",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves both the API and the React build (Workers Static Assets).
  // /api/* always reaches the Worker; everything else is a static file or the SPA shell.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bls-pos",
      // From `wrangler d1 create bls-pos`. Local dev and tests ignore it.
      "database_id": "adca64c3-0577-4fde-97a2-ea97509377fe",
      "migrations_dir": "migrations",
    },
  ],
  // Images (logos, covers, products, avatars). Create with `wrangler r2 bucket create bls-pos-media`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bls-pos-media" }],
  // Set with `wrangler secret put <NAME>` in production, `.dev.vars` locally.
  "secrets": { "required": ["PEPPER", "TURNSTILE_SECRET", "TOTP_ENC_KEY"] },
  // Public shop pages (/api/v1/public/*): at most 120 requests a minute per visitor IP.
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
  ],
  // Nightly daily summaries at 16:10 UTC = 00:10 in Manila (src/worker/cron.ts), and hourly
  // backups at :25, each shop in its own hour (src/worker/backup.ts).
  "triggers": { "crons": ["10 16 * * *", "25 * * * *"] },
  // Environments (Section 11): local = `pnpm dev` with Miniflare; production = the settings
  // above (`pnpm deploy`); preview = its own Worker, database and bucket, so trying a
  // change never touches real shops (`pnpm deploy:preview`). Bindings are not inherited,
  // so they are listed again.
  "env": {
    "preview": {
      "name": "bls-pos-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bls-pos-preview",
          // Replace with the ID printed by `wrangler d1 create bls-pos-preview`.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bls-pos-media-preview" }],
      "ratelimits": [
        {
          "name": "PUBLIC_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      // No scheduled jobs on preview: they would only use the free plan's Cron quota.
      "triggers": { "crons": [] },
    },
  },
}
