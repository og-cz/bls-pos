{
  "name": "bls-pos",
  "version": "0.0.0",
  "private": true,
  "description": "Fast, secure, branded point-of-sale for small businesses",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "icons": "node scripts/make-icons.mjs",
    "audit": "pnpm audit --audit-level high",
    "size": "node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "~5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@fontsource/poppins": "5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "1.3.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "papaparse": "^5.7.0",
    "qrcode-generator": "1.4.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-colorful": "5.6.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  }
}
